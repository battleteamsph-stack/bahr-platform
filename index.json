        },
        "2.5.3": {
          "url": "https://raw.githubusercontent.com/battleteamsph-stack/bahr-platform/main/bahr.guard@2.5.3.zip",
          "sha256": "64c32a40d85325ad665ac6fef0bad93dd52d4cc47ec280a4026a875357b6c587",
          "size": 74801,
          "ChangeLog": "v2.5.3: إرسال 100 رسالة بالتوازي عبر 6 حسابات OmniRoute (6×100 = 600 رسالة)، خيار حصر الفحص على OmniRoute فقط دون أي مزودات خارجية، والرصد المباشر والفوري بدون تدقيق ومراجعة ثانية.",
          "dependencies": {
            "valenced.api": {
              "version": ">=1 <2"
            },
            "discord": {
              "version": "*"
            }
          }
        },
        "2.6.0": {
          "url": "https://raw.githubusercontent.com/battleteamsph-stack/bahr-platform/main/bahr.guard@2.6.0.zip",
          "sha256": "9401f9fa73caee377f33709a385f3446eaa69a36168f94d218d14faa3ecbc7cb",
          "size": 74831,
          "ChangeLog": "v2.6.0: قفل صارم على نموذج Gemini 4 Hydrogen بمستوى تفكير منخفض (Low)، سياسة انعدام التبديل (ZERO Fallback)، إيقاف فوري عند حد الاستخدام (Rate-limit)، وتنسيق توجيه فائق السرعة وتوفير التوكنات.",
          "dependencies": {
            "valenced.api": {
              "version": ">=1 <2"
            },
            "discord": {
              "version": "*"
            }
          }
        }
